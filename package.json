{
  "name": "claudeteam",
  "version": "0.1.0",
  "private": true,
  "description": "ClaudeTeam - Multi-agent orchestration desktop app",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:channel": "bun build src/channel/channel-server.ts --outdir dist/channel --target bun",
    "preview": "vite preview",
    "start": "electron dist/main/main/index.js",
    "build:all": "npm run build && npm run build:main && npm run build:channel",
    "package": "npm run build:all && electron-builder --mac",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.469.0",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "sql.js": "^1.11.0",
    "uuid": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@types/sql.js": "^1.4.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
